    "tier2_deliberately_excluded": [
      {
        "schemaName": "ProductVariant",
        "field": "Barcode",
        "declaredUnique": true,
        "recommendation": "DO NOT create this unique index.",
        "why": "Barcode is optional in practice \u2014 most variants will have none. With no sparse option, a unique index permits exactly one variant without a barcode, so the second barcode-less variant you save is rejected. Either drop IsUniqueData from the field, or wait for a sparse/partial index option (see BLOCKS_FEATURE_SUGGESTIONS.md)."
      }
    ],
