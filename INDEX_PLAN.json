{
  "endpoint": "POST /schemas/indexes",
  "verifiedAgainst": [
    "blocks-data/server/Api/Controllers/DataGateway/SchemaIndexController.cs:46-61",
    "blocks-data/server/DataGateway.DomainService/Services/Implementations/SchemaIndexService.cs:34-127",
    "blocks-data/server/DataGateway.DomainService/Models/CreateSchemaIndexRequest.cs",
    "blocks-data/server/DataGateway.DomainService/Validators/CreateSchemaIndexRequestValidator.cs"
  ],
  "constraints": {
    "entityOnly": "SchemaType must be Entity (1). DTO schemas are not indexable.",
    "scalarOnly": "Field must exist on the schema, be a GraphQL scalar (String/Int/Float/Boolean/DateTime/ID), and have IsReferenceField=false.",
    "noEmbeddedFields": "Every dotted sub-field (Quantity.OnHand, Items.VariantId, Address.City, ...) carries IsReferenceField=true in this project's export, so NONE of them can be indexed. See SCHEMA_BATCH_2.md.",
    "maxFieldsPerIndex": 10,
    "maxIndexesPerSchema": 15,
    "indexNameIsDerived": "Name is built as <Field>_<1|-1> joined by _ and cannot be chosen; creating the same key set twice returns 409 INDEX_ALREADY_EXISTS.",
    "noSparseOrPartial": "CreateIndexOptions sets only Name and Unique \u2014 sparse, partial, TTL and collation are not exposed."
  },
  "indexes": {
    "tier1_correctness": [
      {
        "schemaName": "InventoryMovement",
        "why": "The one index the CAS/ledger design actually depends on. IsUniqueData is a check-then-act query, not a constraint; without this, a retried reserve can double-write a movement.",
        "request": {
          "SchemaDefinitionItemId": "<ItemId of the InventoryMovement schema definition>",
          "Fields": [
            {
              "FieldName": "IdempotencyKey",
              "Direction": "ASC"
            }
          ],
          "IsUnique": true
        },
        "derivedIndexName": "IdempotencyKey_1",
        "hazard": "Unique index with no sparse/partial option: MongoDB treats a missing field as null, so at most ONE existing document may lack this field. Backfill every record before creating this index, or creation fails with UNIQUE_INDEX_CONFLICT (409) and later inserts that omit the field fail too."
      },
      {
        "schemaName": "WarehouseInventory",
        "why": "The natural key. Two balance rows for the same variant+warehouse would make AvailableToSell sum wrong AND make every compare-and-swap update the wrong row \u2014 a silent oversell. Nothing enforces this today.",
        "request": {
          "SchemaDefinitionItemId": "<ItemId of the WarehouseInventory schema definition>",
          "Fields": [
            {
              "FieldName": "WarehouseId",
              "Direction": "ASC"
            },
            {
              "FieldName": "VariantId",
              "Direction": "ASC"
            }
          ],
          "IsUnique": true
        },
        "derivedIndexName": "WarehouseId_1_VariantId_1",
        "hazard": "Deduplicate existing rows first if any warehouse/variant pair repeats."
      },
      {
        "schemaName": "Order",
        "why": "Retry-safe checkout. placeOrder() already generates and reuses a key per attempt; this is what makes it mean something.",
        "request": {
          "SchemaDefinitionItemId": "<ItemId of the Order schema definition>",
          "Fields": [
            {
              "FieldName": "IdempotencyKey",
              "Direction": "ASC"
            }
          ],
          "IsUnique": true
        },
        "derivedIndexName": "IdempotencyKey_1",
        "requires": "U2 (Commerce schemas imported)",
        "hazard": "Unique index with no sparse/partial option: MongoDB treats a missing field as null, so at most ONE existing document may lack this field. Backfill every record before creating this index, or creation fails with UNIQUE_INDEX_CONFLICT (409) and later inserts that omit the field fail too."
      },
      {
        "schemaName": "Order",
        "why": "Order numbers must not collide.",
        "request": {
          "SchemaDefinitionItemId": "<ItemId of the Order schema definition>",
          "Fields": [
            {
              "FieldName": "OrderNumber",
              "Direction": "ASC"
            }
          ],
          "IsUnique": true
        },
        "derivedIndexName": "OrderNumber_1",
        "requires": "U2"
      }
    ],
