              "Description": null
            }
          ],
          "NestedGroups": []
        },
        "Priority": 1,
        "IsAllowPolicy": true
      },
      {
        "PolicyName": "admin can delete favourites",
        "PolicyDescription": "Right-to-erasure and cleanup. Deliberately no admin *read* policy: staff have no business browsing wishlists, and adding one later is a decision, not an oversight to correct.",
