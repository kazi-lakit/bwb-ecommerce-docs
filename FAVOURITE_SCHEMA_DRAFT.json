        },
        "Priority": 1,
        "IsAllowPolicy": true
      },
      {
        "PolicyName": "signed-in customers can add a favourite",
        "PolicyDescription": "Write access is User. CustomerId must be stamped from the authenticated caller by the app; a client that sends someone else's id creates a row it then cannot read, which is harmless but pointless.",
        "PolicyType": 0,
        "Operation": 1,
        "RuleGroup": {
          "LogicalOperator": 0,
          "Rules": [
            {
