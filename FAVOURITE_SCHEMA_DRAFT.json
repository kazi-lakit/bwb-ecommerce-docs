        },
        "Priority": 1,
        "IsAllowPolicy": true
      },
      {
        "PolicyName": "customers can remove their own favourites",
        "PolicyDescription": "Delete is how un-favouriting works, so customers need it \u2014 scoped to their own rows.",
        "PolicyType": 0,
        "Operation": 3,
        "RuleGroup": {
          "LogicalOperator": 0,
